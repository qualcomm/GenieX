+// geniex: hand VTCM and HMX to a client that asked for them, without waiting
+// for the end of the batch. A batch can be a whole graph, and a client with a
+// deadline (e.g. a functional-safety self-test that the host treats as a fatal
+// DSP fault when it times out) cannot wait that long. VTCM only holds per-op
+// scratch, so yielding between ops is safe.
+void htp_vtcm_yield(struct htp_context * ctx) {
+    if (!ctx->vtcm_needs_release) {
+        return;
+    }
+
+    // The hmx-queue thread holds the HMX lock and the workers spin while active
+    if (ctx->hmx_queue) {
+        hmx_queue_suspend(ctx->hmx_queue);
+        hmx_queue_flush(ctx->hmx_queue);
+    }
+    work_queue_suspend(ctx->work_queue);
+
+    vtcm_release(ctx);
+    vtcm_acquire(ctx);
+
+    work_queue_wakeup(ctx->work_queue);
+    if (ctx->hmx_queue) {
+        hmx_queue_wakeup(ctx->hmx_queue);
+    }
+}
