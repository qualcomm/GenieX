+void htp_fa_kv_invalidate(struct htp_context * ctx, const struct htp_tensor * dst) {
+    if (!dst) {
+        return;
+    }
+    for (uint32_t i = 0; i < HTP_FA_KV_SLOTS; ++i) {
+        struct htp_fa_kv_slot * s = &ctx->fa_kv[i];
+        if (s->state == 0) {
+            continue;
+        }
+        if (fa_kv_overlap(dst->data, dst->size, s->k_data, s->k_size) || fa_kv_overlap(dst->data, dst->size, s->v_data, s->v_size)) {
+            fa_kv_drop(s);
