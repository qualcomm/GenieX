-                               op == HTP_OP_RMS_NORM_MUL || op == HTP_OP_L2_NORM ||
-                               op == HTP_OP_HADAMARD);
+                               op == HTP_OP_RMS_NORM_MUL || op == HTP_OP_L2_NORM);
     // The tiled fallback path below only has F32 task functions (unary_task_f32_tiled_*);
