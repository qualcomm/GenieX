+static uint32_t fa_kv_blocks_live(const struct htp_tensor * mask, uint32_t q_start, uint32_t n_rows_q, uint32_t im3,
+                                  uint32_t Bc, uint32_t nek1, uint32_t n_kv_blocks) {
