+// ---------------------------------------------------------------------------------------------------------------
+// Shared q8_0 views use f16 working copies from the second reader onward.
+// Ready data survives batches; row writes refresh quantized rows before a later reader uses the copy.
+// ---------------------------------------------------------------------------------------------------------------
+#define FA_KVCOPY_ROWS 16
+
+typedef struct {
+    struct htp_context * ctx;
+    uint64_t             src;       // DDR address of the first q8_0 row
+    uint32_t             src_nb1;   // bytes between q8_0 rows
+    uint8_t *            dst;       // f16 rows, contiguous
+    uint32_t             rows;
+    uint32_t             dk;
+    size_t               in_bytes;  // per-buffer size of the q8_0 staging area
+    size_t               out_bytes;
+} fa_kvcopy_args_t;
+
+static void fa_kvcopy_thread(unsigned int n, unsigned int i, void * data) {
+    const fa_kvcopy_args_t * a = (const fa_kvcopy_args_t *) data;
+
+    const uint32_t per   = (a->rows + n - 1) / n;
+    const uint32_t start = i * per;
+    const uint32_t end   = hex_smin(start + per, a->rows);
+    if (start >= end) {
+        return;
+    }
+
+    const uint32_t row_q8  = (a->dk / QK8_0) * sizeof(block_q8_0);
+    const uint32_t row_f16 = a->dk * sizeof(__fp16);
+    const uint32_t nc      = (end - start + FA_KVCOPY_ROWS - 1) / FA_KVCOPY_ROWS;
+
+    uint8_t * vt   = a->ctx->vtcm_base + (size_t) i * (2 * a->in_bytes + a->out_bytes);
+    uint8_t * in_b[2] = { vt, vt + a->in_bytes };
+    uint8_t * out_b   = vt + 2 * a->in_bytes;
+    dma_queue * q = a->ctx->dma[i];
+
+    #define KVC_ROWS(c) hex_smin(FA_KVCOPY_ROWS, end - start - (c) * FA_KVCOPY_ROWS)
+    #define KVC_PUSH_IN(c) \
+        dma_queue_push(q, dma_make_data(in_b[(c) & 1], a->src + (uint64_t) (start + (c) * FA_KVCOPY_ROWS) * a->src_nb1), \
+                       row_q8, a->src_nb1, row_q8, KVC_ROWS(c))
+
+    // queue invariant at the top of iteration c: [in(c)] (c == 0) or [in(c), out(c-1)] (c > 0)
+    KVC_PUSH_IN(0);
+    for (uint32_t c = 0; c < nc; ++c) {
+        if (c + 1 < nc) {
+            KVC_PUSH_IN(c + 1);
+        }
+        dma_queue_pop(q);          // in(c)
+        if (c > 0) {
+            dma_queue_pop(q);      // out(c-1): the single output buffer is free again
+        }
+        const uint32_t cnt = KVC_ROWS(c);
+        for (uint32_t r = 0; r < cnt; ++r) {
+            hvx_dequantize_row_q8_0_f16((__fp16 *) (out_b + (size_t) r * row_f16), in_b[c & 1] + (size_t) r * row_q8, a->dk);
+        }
+        dma_queue_push(q, dma_make_data(a->dst + (size_t) (start + c * FA_KVCOPY_ROWS) * row_f16, out_b),
+                       row_f16 * cnt, row_f16 * cnt, row_f16 * cnt, 1);
+    }
+    dma_queue_flush(q);
+    #undef KVC_PUSH_IN
+    #undef KVC_ROWS
+}
+
+static void fa_kv_drop(struct htp_fa_kv_slot * s) {
+    s->state = 0;
+    s->dirty_mask = 0;
+}
+
+static bool fa_kv_overlap(uint64_t a, uint64_t a_size, uint64_t b, uint64_t b_size) {
+    if (!a_size || !b_size) {
+        return false;
+    }
+    if (a > UINT64_MAX - a_size || b > UINT64_MAX - b_size) {
+        return true;
+    }
+    return a <= b ? b - a < a_size : a - b < b_size;
+}
+
+static bool fa_kv_source_valid(const struct htp_tensor * t) {
+    if (!t->ne[0] || !t->ne[1] || !t->ne[2] || t->ne[3] != 1 || t->nb[0] != sizeof(block_q8_0) ||
+        t->data > UINT64_MAX - t->size) {
+        return false;
+    }
+    const uint64_t row_bytes = (uint64_t) (t->ne[0] / QK8_0) * sizeof(block_q8_0);
+    if (row_bytes > t->size) {
+        return false;
+    }
+    const uint64_t available = t->size - row_bytes;
+    const uint64_t head_offset = (uint64_t) (t->ne[2] - 1) * t->nb[2];
+    const uint64_t row_offset = (uint64_t) (t->ne[1] - 1) * t->nb[1];
+    return head_offset <= available && row_offset <= available - head_offset;
+}
+
+static bool fa_kv_f16_size(const struct htp_tensor * t, size_t * bytes) {
+    const uint64_t row_bytes = (uint64_t) t->ne[0] * sizeof(__fp16);
+    const uint64_t rows = (uint64_t) t->ne[1] * t->ne[2];
+    if (!row_bytes || row_bytes > UINT32_MAX || rows > UINT32_MAX / row_bytes) {
+        return false;
+    }
+    const uint64_t size = row_bytes * rows;
+    if (size > SIZE_MAX - 127) {
+        return false;
+    }
+    *bytes = hex_align_up((size_t) size, 128);
+    return true;
+}
+
+static bool fa_kv_copy_layout(struct htp_context * ctx, const struct htp_fa_kv_slot * s, size_t in[2], size_t out[2]) {
+    for (uint32_t part = 0; part < 2; ++part) {
+        const uint32_t width = part ? s->dv : s->dk;
+        const uint64_t in_bytes = (uint64_t) FA_KVCOPY_ROWS * (width / QK8_0) * sizeof(block_q8_0);
+        const uint64_t out_bytes = (uint64_t) FA_KVCOPY_ROWS * width * sizeof(__fp16);
+        if (in_bytes > SIZE_MAX - 127 || out_bytes > SIZE_MAX - 127) {
+            return false;
+        }
+        in[part] = hex_align_up((size_t) in_bytes, 128);
+        out[part] = hex_align_up((size_t) out_bytes, 128);
+    }
+    const size_t in_max = hex_smax(in[0], in[1]);
+    const size_t out_max = hex_smax(out[0], out[1]);
+    if (in_max > (SIZE_MAX - out_max) / 2 || !ctx->n_threads) {
+        return false;
+    }
+    return 2 * in_max + out_max <= ctx->vtcm_size / ctx->n_threads;
+}
+
+static bool fa_kv_prepare_dirty(struct htp_fa_kv_slot * s) {
+    const uint64_t n_rows = (uint64_t) s->n_heads * s->nek1;
+    const uint64_t n_words = (n_rows + 63) / 64;
+    if (!n_words || n_words > SIZE_MAX / (2 * sizeof(uint64_t))) {
+        return false;
+    }
+    if (n_words > s->dirty_cap_words) {
+        uint64_t * dirty = calloc((size_t) n_words * 2, sizeof(uint64_t));
+        if (!dirty) {
+            return false;
+        }
+        free(s->dirty);
+        s->dirty = dirty;
+        s->dirty_cap_words = (size_t) n_words;
+    } else {
+        memset(s->dirty, 0, s->dirty_cap_words * 2 * sizeof(uint64_t));
+    }
+    s->dirty_words = (size_t) n_words;
+    s->dirty_mask = 0;
+    return true;
+}
+
+static uint64_t fa_kv_next_dirty(const uint64_t * dirty, size_t n_words, uint64_t first, uint64_t end) {
+    const size_t head_words = (size_t) ((end + 63) / 64);
+    n_words = n_words < head_words ? n_words : head_words;
+    size_t word = (size_t) (first / 64);
+    if (word >= n_words) {
+        return end;
+    }
+    uint64_t bits = dirty[word] & (UINT64_MAX << (first % 64));
+    while (!bits && ++word < n_words) {
+        bits = dirty[word];
+    }
+    if (!bits) {
+        return end;
+    }
+    const uint64_t row = (uint64_t) word * 64 + (uint32_t) __builtin_ctzll(bits);
+    return row < end ? row : end;
+}
+
+static bool fa_kv_refresh(struct htp_context * ctx, struct htp_fa_kv_slot * s, const struct htp_tensor * k, const struct htp_tensor * v) {
+    if (!s->dirty_mask) {
+        return true;
+    }
+    const uint32_t nth = ctx->n_threads;
+    size_t in[2], out[2];
+    if (!fa_kv_copy_layout(ctx, s, in, out)) {
+        return false;
+    }
+    const size_t k_bytes = s->k_bytes;
+    for (uint32_t part = 0; part < 2; ++part) {
+        if (!(s->dirty_mask & (1U << part))) {
+            continue;
+        }
+        const struct htp_tensor * t = part ? v : k;
+        const uint32_t width = part ? s->dv : s->dk;
+        const size_t row_f16 = (size_t) width * sizeof(__fp16);
+        uint8_t * dst = s->buf + (part ? k_bytes : 0);
+        uint64_t * dirty = s->dirty + (part ? s->dirty_cap_words : 0);
+        for (uint32_t h = 0; h < s->n_heads; ++h) {
+            const uint64_t first = (uint64_t) h * s->nek1;
+            const uint64_t limit = first + s->nek1;
+            uint64_t begin = fa_kv_next_dirty(dirty, s->dirty_words, first, limit);
+            while (begin < limit) {
+                uint64_t end = begin + 1;
+                while (end < limit && (dirty[end / 64] & (UINT64_C(1) << (end % 64)))) {
+                    ++end;
+                }
+                const uint32_t row = (uint32_t) (begin - first);
+                fa_kvcopy_args_t args = {
+                    ctx, t->data + (uint64_t) h * t->nb[2] + (uint64_t) row * t->nb[1], t->nb[1],
+                    dst + ((size_t) h * s->nek1 + row) * row_f16, (uint32_t) (end - begin), width,
+                    in[part], out[part]
+                };
+                work_queue_run(ctx->work_queue, fa_kvcopy_thread, &args, nth);
+                for (uint64_t i = begin; i < end; ++i) {
+                    dirty[i / 64] &= ~(UINT64_C(1) << (i % 64));
+                }
+                begin = fa_kv_next_dirty(dirty, s->dirty_words, end, limit);
+            }
+        }
+    }
+    s->dirty_mask = 0;
+    return true;
+}
+
+static bool fa_kv_build(struct htp_context * ctx, struct htp_fa_kv_slot * s, const struct htp_tensor * k, const struct htp_tensor * v) {
+    if (!fa_kv_prepare_dirty(s)) {
+        return false;
+    }
+    const size_t k_bytes = s->k_bytes;
+    const size_t v_bytes = s->v_bytes;
+
+    if (k_bytes + v_bytes > s->cap) {
+        if (s->buf) {
+            free(s->buf);
+            s->buf = NULL;
+            s->cap = 0;
+        }
+        s->buf = (uint8_t *) memalign(128, k_bytes + v_bytes);
+        if (!s->buf) {
+            return false;
+        }
+        s->cap = k_bytes + v_bytes;
+        // the buffer is only ever written by DMA: drop stale dirty lines left by earlier users of this heap memory so they cannot be written back over it
+        hex_l2flush(s->buf, s->cap);
+    }
+
+    const uint32_t nth = ctx->n_threads;
+    size_t in[2], out[2];
+    if (!fa_kv_copy_layout(ctx, s, in, out)) {
+        return false;
+    }
+
+    for (uint32_t h = 0; h < s->n_heads; ++h) {
+        fa_kvcopy_args_t ak = { ctx, k->data + (uint64_t) h * s->k_nb2, s->k_nb1, s->buf + (size_t) h * s->nek1 * s->dk * sizeof(__fp16),
+                                s->nek1, s->dk, in[0], out[0] };
+        work_queue_run(ctx->work_queue, fa_kvcopy_thread, &ak, nth);
+
+        fa_kvcopy_args_t av = { ctx, v->data + (uint64_t) h * s->v_nb2, s->v_nb1, s->buf + k_bytes + (size_t) h * s->nek1 * s->dv * sizeof(__fp16),
+                                s->nek1, s->dv, in[1], out[1] };
+        work_queue_run(ctx->work_queue, fa_kvcopy_thread, &av, nth);
+    }
+    return true;
+}
