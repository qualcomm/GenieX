+
+// Marks every cached (head, row) cell that overlaps a byte range written by SET_ROWS. Mapping is by address, so head-major,
+// token-interleaved (llama.cpp [n_embd_gqa, cap] caches viewed per head) and aliased layouts all work. Any descriptor this
+// cannot bound returns false and the caller drops the whole copy.
+static bool fa_kv_mark_rows(struct htp_fa_kv_slot * s, const struct htp_tensor * dst, const struct htp_tensor * indices, uint32_t part) {
+    const uint64_t base = part ? s->v_data : s->k_data;
+    const uint32_t width = part ? s->dv : s->dk;
+    const uint32_t row_stride = part ? s->v_nb1 : s->k_nb1;
+    const uint32_t head_stride = part ? s->v_nb2 : s->k_nb2;
+    const uint64_t row_bytes = (uint64_t) (width / QK8_0) * sizeof(block_q8_0);
+    const uint64_t seg_bytes = (uint64_t) (dst->ne[0] / QK8_0) * sizeof(block_q8_0);
+    if (!indices || dst->type != HTP_TYPE_Q8_0 || dst->nb[0] != sizeof(block_q8_0) || (dst->ne[0] % QK8_0) || !seg_bytes ||
+        seg_bytes > dst->size || !row_stride || !s->dirty || !dst->ne[1] || !dst->ne[2] || !dst->ne[3] ||
+        !indices->ne[0] || !indices->ne[1] || !indices->ne[2] || indices->ne[3] != 1 ||
+        (dst->ne[2] % indices->ne[1]) || (dst->ne[3] % indices->ne[2]) ||
+        (indices->type != HTP_TYPE_I32 && indices->type != HTP_TYPE_I64)) {
+        return false;
+    }
+    if (dst->data > UINT64_MAX - dst->size || indices->data > UINT64_MAX - indices->size || indices->data > UINTPTR_MAX ||
+        (indices->size && (uint64_t) indices->size - 1 > UINTPTR_MAX - indices->data)) {
+        return false;
+    }
+    // signed relative addressing below needs every product and address to stay far from INT64_MAX
+    if (dst->data > (uint64_t) INT64_MAX / 4 || base > (uint64_t) INT64_MAX / 4 ||
+        (uint64_t) (s->n_heads - 1) * head_stride > (uint64_t) INT64_MAX / 4 || (uint64_t) s->nek1 * row_stride > (uint64_t) INT64_MAX / 4) {
+        return false;
+    }
+    const size_t index_bytes = indices->type == HTP_TYPE_I64 ? sizeof(int64_t) : sizeof(int32_t);
+    if (indices->size < index_bytes) {
+        return false;
+    }
+    uint64_t room = indices->size - index_bytes;
+    for (uint32_t d = 0; d < 3; ++d) {
+        const uint64_t term = (uint64_t) (indices->ne[d] - 1) * indices->nb[d];
+        if (term > room) {
+            return false;
+        }
+        room -= term;
+    }
+    uint64_t * dirty = s->dirty + (part ? s->dirty_cap_words : 0);
+    for (uint32_t b = 0; b < dst->ne[3]; ++b) {
+        for (uint32_t h = 0; h < dst->ne[2]; ++h) {
+            for (uint32_t i = 0; i < indices->ne[0]; ++i) {
+                // SET_ROWS broadcasts the index tensor over the batch dims of the destination
+                const uint64_t index_offset = (uint64_t) (b % indices->ne[2]) * indices->nb[2] + (uint64_t) (h % indices->ne[1]) * indices->nb[1] +
+                                              (uint64_t) i * indices->nb[0];
+                const void * index_data = (const void *) (uintptr_t) (indices->data + index_offset);
+                int64_t row;
+                if (indices->type == HTP_TYPE_I64) {
+                    memcpy(&row, index_data, sizeof(row));
+                } else {
+                    int32_t row32;
+                    memcpy(&row32, index_data, sizeof(row32));
+                    row = row32;
+                }
+                if (row < 0 || (uint64_t) row >= dst->ne[1]) {
+                    continue;
+                }
+                const uint64_t offset_b = (uint64_t) b * dst->nb[3];
+                const uint64_t offset_h = (uint64_t) h * dst->nb[2];
+                const uint64_t offset_r = (uint64_t) row * dst->nb[1];
+                const uint64_t available = dst->size - seg_bytes;
+                if (offset_b > available || offset_h > available - offset_b || offset_r > available - offset_b - offset_h) {
+                    return false;
+                }
+                const int64_t rel0 = (int64_t) (dst->data + offset_b + offset_h + offset_r) - (int64_t) base;
+                for (uint32_t c = 0; c < s->n_heads; ++c) {
+                    // cell (c, r) starts at r*row_stride within head c's origin; it overlaps the written segment when
+                    // rel - row_bytes < r*row_stride < rel + seg_bytes
+                    const int64_t rel  = rel0 - (int64_t) c * head_stride;
+                    const int64_t last = rel + (int64_t) seg_bytes - 1;
+                    if (last < 0) {
+                        continue;
+                    }
+                    const int64_t first_num = rel - (int64_t) row_bytes + 1;
+                    const uint64_t r0 = first_num <= 0 ? 0 : ((uint64_t) first_num + row_stride - 1) / row_stride;
+                    uint64_t       r1 = (uint64_t) last / row_stride;
+                    if (r1 >= s->nek1) {
+                        r1 = (uint64_t) s->nek1 - 1;
+                    }
+                    for (uint64_t r = r0; r <= r1; ++r) {
+                        const uint64_t bit = (uint64_t) c * s->nek1 + r;
+                        if (bit / 64 >= s->dirty_words) {
+                            return false;
+                        }
+                        dirty[bit / 64] |= UINT64_C(1) << (bit % 64);
+                        s->dirty_mask |= 1U << part;
+                    }
+                }
+            }
+        }
+    }
+    return true;
+}
+
+void htp_fa_kv_invalidate_rows(struct htp_context * ctx, const struct htp_tensor * dst, const struct htp_tensor * indices) {
+    if (!dst) {
+        return;
+    }
+    for (uint32_t i = 0; i < HTP_FA_KV_SLOTS; ++i) {
+        struct htp_fa_kv_slot * s = &ctx->fa_kv[i];
+        if (!s->state) {
+            continue;
+        }
+        const bool k_hit = fa_kv_overlap(dst->data, dst->size, s->k_data, s->k_size);
+        const bool v_hit = fa_kv_overlap(dst->data, dst->size, s->v_data, s->v_size);
+        if (!k_hit && !v_hit) {
+            continue;
+        }
+        if (s->state == 1) {
+            // No copy exists yet and the admission mark must survive: the build reads the destination bytes as they are
+            // when the second reader runs.
+            continue;
+        }
+        if ((k_hit && !fa_kv_mark_rows(s, dst, indices, 0)) || (v_hit && !fa_kv_mark_rows(s, dst, indices, 1))) {
+            fa_kv_drop(s);
+        }
+    }
+}
+
+void htp_fa_kv_free(struct htp_context * ctx) {
+    for (uint32_t i = 0; i < HTP_FA_KV_SLOTS; ++i) {
+        free(ctx->fa_kv[i].buf);
+        free(ctx->fa_kv[i].dirty);
+        memset(&ctx->fa_kv[i], 0, sizeof(ctx->fa_kv[i]));
+    }
+}
+
+// Returns true and fills kc/vc with f16 views of the cache when the copy is available for this op.
+static bool fa_kv_acquire(struct htp_context * ctx, const struct htp_tensor * k, const struct htp_tensor * v, bool admit,
+                          struct htp_tensor * kc, struct htp_tensor * vc) {
+    if (k->type != HTP_TYPE_Q8_0 || v->type != HTP_TYPE_Q8_0 || ctx->mdev.count > 1 ||
+        k->ne[3] != 1 || v->ne[3] != 1 || k->ne[2] != v->ne[2] || k->ne[1] != v->ne[1] ||
+        (k->ne[0] % QK8_0) != 0 || (v->ne[0] % QK8_0) != 0 || !k->ne[1] ||
+        k->nb[0] != sizeof(block_q8_0) || v->nb[0] != sizeof(block_q8_0)) {
+        return false;
+    }
+    if ((k->flags | v->flags) & HTP_TENSOR_HOST_WRITABLE) {
+        return false;
+    }
+
+    struct htp_fa_kv_slot * s = NULL;
+    for (uint32_t i = 0; i < HTP_FA_KV_SLOTS; ++i) {
+        struct htp_fa_kv_slot * c = &ctx->fa_kv[i];
+        if (!c->state || c->k_data != k->data || c->v_data != v->data) {
+            continue;
+        }
+        if (c->k_generation != k->generation || c->v_generation != v->generation || c->k_size != k->size || c->v_size != v->size ||
+            c->nek1 != k->ne[1] || c->dk != k->ne[0] || c->dv != v->ne[0] || c->n_heads != k->ne[2] ||
+            c->k_nb1 != k->nb[1] || c->k_nb2 != k->nb[2] || c->v_nb1 != v->nb[1] || c->v_nb2 != v->nb[2] ||
+            c->k_nb3 != k->nb[3] || c->v_nb3 != v->nb[3]) {
+            fa_kv_drop(c);
+            continue;
+        }
+        s = c;
+        break;
+    }
+
+    if (!s) {
+        if (!admit) {
+            return false;
+        }
+        size_t k_bytes, v_bytes;
+        if (!fa_kv_source_valid(k) || !fa_kv_source_valid(v) || !fa_kv_f16_size(k, &k_bytes) || !fa_kv_f16_size(v, &v_bytes) ||
+            k_bytes > SIZE_MAX - v_bytes) {
+            return false;
+        }
+        // Keep ready shared copies ahead of entries that have only had one reader.
+        struct htp_fa_kv_slot * victim = NULL;
+        for (uint32_t i = 0; i < HTP_FA_KV_SLOTS; ++i) {
+            struct htp_fa_kv_slot * c = &ctx->fa_kv[i];
+            if (!c->state) { victim = c; break; }
+            if (!victim || (c->state == 1 && victim->state == 2) ||
+                (c->state == victim->state && (int32_t) (c->stamp - victim->stamp) < 0)) {
+                victim = c;
+            }
+        }
+        victim->k_data = k->data;   victim->v_data = v->data;
+        victim->k_size = k->size;   victim->v_size = v->size;
+        victim->k_generation = k->generation; victim->v_generation = v->generation;
+        victim->nek1   = k->ne[1];  victim->dk = k->ne[0];  victim->dv = v->ne[0];  victim->n_heads = k->ne[2];
+        victim->k_nb1  = k->nb[1];  victim->k_nb2 = k->nb[2];
+        victim->v_nb1  = v->nb[1];  victim->v_nb2 = v->nb[2];
+        victim->k_nb3 = k->nb[3]; victim->v_nb3 = v->nb[3];
+        victim->k_bytes = k_bytes; victim->v_bytes = v_bytes;
+        victim->state  = 1;
+        victim->dirty_mask = 0;
+        victim->stamp  = ++ctx->fa_kv_clock;
+        return false;
+    }
+
+    if (s->state == 1 && !admit) {
+        return false;
+    }
+    s->stamp = ++ctx->fa_kv_clock;
+    // A ready copy is kept current by row refresh, so any reader may use it. A slot still being admitted (state 1) waits for
+    // a second reader, which may be the next batch's reader of the same cache, before paying for the full build.
+    if (s->state == 1) {
+        if (!fa_kv_build(ctx, s, k, v)) {
+            fa_kv_drop(s);
+            return false;
+        }
+        s->state = 2;
+    } else if (!fa_kv_refresh(ctx, s, k, v)) {
+        fa_kv_drop(s);
+        return false;
+    }
+
+    const size_t k_bytes = s->k_bytes;
+
+    *kc = *k;
+    kc->type = HTP_TYPE_F16;
+    kc->data = (uint64_t) (uintptr_t) s->buf;
+    kc->nb[0] = sizeof(__fp16);
+    kc->nb[1] = s->dk * sizeof(__fp16);
+    kc->nb[2] = kc->nb[1] * s->nek1;
+    kc->nb[3] = kc->nb[2] * s->n_heads;
+    kc->size  = kc->nb[3];
+
+    *vc = *v;
+    vc->type = HTP_TYPE_F16;
+    vc->data = (uint64_t) (uintptr_t) (s->buf + k_bytes);
+    vc->nb[0] = sizeof(__fp16);
+    vc->nb[1] = s->dv * sizeof(__fp16);
+    vc->nb[2] = vc->nb[1] * s->nek1;
+    vc->nb[3] = vc->nb[2] * s->n_heads;
+    vc->size  = vc->nb[3];
+    return true;
+}
