load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = [
        "compute.go",
        "config.go",
    ],
    importpath = "github.com/qualcomm/GenieX/cli/internal/config",
    visibility = ["//cli:__subpackages__"],
    deps = ["@com_github_spf13_viper//:viper"],
